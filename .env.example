# =============================================================
# CLOAK 环境变量模板:复制为 .env 后填写;开发默认值即下列值,可直接使用。
# 读取方:Go 后端(internal/config/config.go)、docker compose、Caddy。
# 时长格式遵循 Go time.ParseDuration:如 720h、24h、5m。
# =============================================================

# ---------- 基础服务 ----------
# HTTP 监听地址:后端对外端口(开发 :8081;生产容器内固定 :8080)
CLOAK_ADDR=:8080
# 平台裸域名:租户默认域名形如 <slug>.<平台域名>(开发用 RFC 保留测试域 cloak.test)
CLOAK_PLATFORM_DOMAIN=cloak.test
# 服务器公网 IP:租户自有域名激活时,比对 DNS A/AAAA 是否指向它(开发用 127.0.0.1)
CLOAK_SERVER_PUBLIC_IP=127.0.0.1
# 后台访问地址:邮件(邮箱验证/密码重置)里链接的前缀
CLOAK_PUBLIC_BASE_URL=https://app.cloak.test

# ---------- 数据库 ----------
# 后端直连 Postgres 的连接串(开发连宿主机 localhost:5432)
CLOAK_DATABASE_URL=postgres://cloak:cloak@localhost:5432/cloak?sslmode=disable
# 以下三个给 docker-compose.prod.yml 用:创建 postgres 容器并拼出容器内的 CLOAK_DATABASE_URL
# (开发 compose 内置 cloak/cloak/cloak,不读这三个;生产必须修改密码)
CLOAK_DB_USER=cloak
CLOAK_DB_PASSWORD=cloak
CLOAK_DB_NAME=cloak
# 测试库连接串:go test 用,与开发库分离(每次测试 Setup 会清空业务表)
CLOAK_TEST_DATABASE_URL=postgres://cloak:cloak@localhost:5432/cloak_test?sslmode=disable
# SQL 迁移文件目录(生产容器内为 /app/migrations)
CLOAK_MIGRATIONS_DIR=migrations

# ---------- 账号与会话 ----------
# 超管邮箱:首次启动自动初始化该账号(登录时引导设置密码;留空则无超管)
CLOAK_SUPERADMIN_EMAIL=
# 会话 cookie 的 Secure 标记:开发(http)必须 false;生产(https)必须 true
CLOAK_COOKIE_SECURE=false
# 登录会话有效期:勾选"记住我"或默认(30 天)
CLOAK_SESSION_TTL=720h
# 未勾选"记住我"时的短会话有效期(24 小时)
CLOAK_SESSION_TTL_SHORT=24h
# 邮箱验证 token 有效期(24 小时)
CLOAK_VERIFY_TOKEN_TTL=24h
# 密码重置 token 有效期(1 小时)
CLOAK_RESET_TOKEN_TTL=1h
# JWT 签名密钥(API Bearer 认证):生产必须配置强随机值;留空则每次启动随机生成,重启后已签发 token 失效
CLOAK_JWT_SECRET=
# JWT 访问 token 有效期(24 小时;过期后需重新调用 POST /api/auth/token 获取)
CLOAK_JWT_TTL=24h

# ---------- 域名激活与访问统计 ----------
# DNS 激活校验的重试间隔:每隔多久查一次租户域名的解析
CLOAK_DNS_RETRY_INTERVAL=5m
# DNS 激活校验的最长等待:超过此时长解析仍未指向本机,域名置 failed
CLOAK_DNS_MAX_AGE=72h
# 访问记录保留时长(90 天后清理)
CLOAK_VISIT_RETENTION=2160h
# 访问记录清理任务的执行间隔(每 24 小时跑一次)
CLOAK_VISIT_CLEANUP_INTERVAL=24h

# ---------- 落地页上传(压缩包托管) ----------
# 上传落地页(zip 解压后)的存放目录,生产部署挂持久卷(见 docker-compose.prod.yml)
CLOAK_LANDING_UPLOAD_DIR=uploads
# 压缩包解压后总大小上限(字节,默认 10MB)
CLOAK_LANDING_MAX_ZIP_BYTES=10485760
# 压缩包文件数上限
CLOAK_LANDING_MAX_FILES=500

# ---------- SMTP 邮件(可选) ----------
# 配置了 HOST 即启用真实邮件发送;全部留空则用控制台假 mailer(邮件内容打印在后端日志)
# SMTP 服务器地址
CLOAK_SMTP_HOST=
# SMTP 端口:465=隐式 TLS;587 必须支持 STARTTLS,否则拒绝
CLOAK_SMTP_PORT=465
# SMTP 登录用户名(留空则不发送 AUTH)
CLOAK_SMTP_USERNAME=
# SMTP 密码/授权码
CLOAK_SMTP_PASSWORD=
# 发件人地址:留空回退为 Username;两者都空则发送报错
CLOAK_SMTP_FROM=

# ---------- 生产 TLS(仅生产环境使用,开发忽略) ----------
# Let's Encrypt 账户邮箱:docker-compose.prod.yml 传给 Caddy(Caddyfile.prod 的 email 指令用,到期提醒)
# 留空时保持 Caddyfile.prod 中 email 指令注释状态,否则 Caddy 会启动失败
CLOAK_ACME_EMAIL=
