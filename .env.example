# =============================================================
# Janus 环境变量模板:复制为 .env 后填写;开发默认值即下列值,可直接使用。
# 读取方:Go 后端(internal/config/config.go)、docker compose、Caddy。
# 时长格式遵循 Go time.ParseDuration:如 720h、24h、5m。
# =============================================================

# ---------- 基础服务 ----------
# HTTP 监听地址:后端对外端口(开发 :8081;生产容器内固定 :8080)
JANUS_ADDR=:8080
# 平台裸域名:租户默认域名形如 <slug>.<平台域名>(开发用 RFC 保留测试域 janus.test)
JANUS_PLATFORM_DOMAIN=janus.test
# 服务器公网 IP:租户自有域名激活时,比对 DNS A/AAAA 是否指向它(开发用 127.0.0.1)
JANUS_SERVER_PUBLIC_IP=127.0.0.1

# ---------- 数据库 ----------
# 后端直连 Postgres 的连接串(开发连宿主机 localhost:5432)
JANUS_DATABASE_URL=postgres://janus:janus@localhost:5432/janus?sslmode=disable
# 以下三个给 docker-compose.prod.yml 用:创建 postgres 容器并拼出容器内的 JANUS_DATABASE_URL
# (开发 compose 内置 janus/janus/janus,不读这三个;生产必须修改密码 ——
#  留成 janus 不会让 compose 报错,compose 只挡空值,不会替你挡默认值)
JANUS_DB_USER=janus
JANUS_DB_PASSWORD=janus
JANUS_DB_NAME=janus
# 数据库初始化脚本目录(内含 init.sql;生产容器内为 /app/migrations)
JANUS_MIGRATIONS_DIR=migrations

# ---------- 账号与会话 ----------
# 超管是内置账号:username=superadmin,初始密码 123456,首登强制改密;不需要环境变量。
# 身份模型是 username + 密码,没有邮箱/验证邮件/找回密码,因此不需要任何 SMTP 配置。
# 会话 cookie 的 Secure 标记:开发(http)必须 false;生产(https)必须 true
JANUS_COOKIE_SECURE=false
# 登录会话有效期:勾选"记住我"或默认(30 天)
JANUS_SESSION_TTL=720h
# 未勾选"记住我"时的短会话有效期(24 小时)
JANUS_SESSION_TTL_SHORT=24h
# JWT 签名密钥(API Bearer 认证):生产必须配置强随机值(openssl rand -hex 32;
# 后端要求 ≥ 32 字节,短于 32 字节会拒绝启动);留空则每次启动随机生成,重启后已签发 token 失效
JANUS_JWT_SECRET=
# JWT 访问 token 有效期(24 小时;过期后需重新调用 POST /api/auth/token 获取)
JANUS_JWT_TTL=24h
# 可信代理网段(逗号分隔的 IP 或 CIDR):只有对端落在这些网段时才采信
# X-Forwarded-For。留空 = 谁都不采信,来源 IP 只认 TCP 对端。
# 生产请填 Caddy 所在容器/宿主网段(如 172.16.0.0/12),不要靠"是不是私网"推断。
# 影响范围:认证端点限流、跳转/落地页访客限流、visits.ip 与地理值、规则里的
# ip/country 条件都按它解析来源 IP。留空时认证端点 fail-closed(共享桶),
# 访客侧则回落到"对端是私网即采信 XFF"—— 生产务必配置以免来源 IP 可被伪造。
# 生产 compose 用 ${JANUS_TRUSTED_PROXY_CIDRS:?...} 转发它:留空会让 docker compose up 直接失败(不会静默降级);
# 填 Caddy 容器所在网段,Docker 默认网桥段是 172.16.0.0/12。
JANUS_TRUSTED_PROXY_CIDRS=
# Caddy on-demand TLS 回调端点 /internal/caddy/authorize 的共享密钥。
# 开发与生产都必须配置:同一值要注入两处——后端读 JANUS_CADDY_ASK_TOKEN,
# caddy 容器读 CADDY_ASK_TOKEN(两个 compose 文件用 ${JANUS_CADDY_ASK_TOKEN:?} 传入,
# 留空则 docker compose 直接启动失败,不会静默发出签发失败)。
# 生成一个:openssl rand -hex 32
# 留空时该端点只靠"对端是内网"判断,后端一旦被暴露到公网即可被任意调用。
JANUS_CADDY_ASK_TOKEN=

# ---------- 域名激活与访问统计 ----------
# DNS 激活校验的重试间隔:每隔多久查一次租户域名的解析
JANUS_DNS_RETRY_INTERVAL=5m
# DNS 激活校验的最长等待:超过此时长解析仍未指向本机,域名置 failed
JANUS_DNS_MAX_AGE=72h
# 访问记录保留时长(90 天后清理)
JANUS_VISIT_RETENTION=2160h
# 访问记录清理任务的执行间隔(每 24 小时跑一次)
JANUS_VISIT_CLEANUP_INTERVAL=24h
# 访问记录清理的单批行数。不分批时一条 DELETE 会锁住全部过期行直到提交(长事务)。
JANUS_VISIT_CLEANUP_BATCH=10000

# ---------- 落地页上传(压缩包托管) ----------
# 上传落地页(zip 解压后)的存放目录,生产部署挂持久卷(见 docker-compose.prod.yml)
JANUS_LANDING_UPLOAD_DIR=uploads
# 上传压缩包的大小上限(字节,默认 10MB)
JANUS_LANDING_MAX_ZIP_BYTES=10485760
# 解压后所有文件总大小上限(字节,默认 10MB)。与上传包上限是两个语义不同的限制。
JANUS_LANDING_MAX_TOTAL_BYTES=10485760
# 压缩包文件数上限
JANUS_LANDING_MAX_FILES=500
# 一条短链可配置的目标 URL 个数上限(轮询池大小)
JANUS_MAX_TARGET_URLS=50

# ---------- 生产 TLS(仅生产环境使用,开发忽略) ----------
# Let's Encrypt 账户邮箱:docker-compose.prod.yml 传给 Caddy(Caddyfile.prod 的 email 指令用,到期提醒)。
# 注意:这是 Caddy 的配置项,后端 Go 代码不读它(internal/config 里没有这个变量),
# 所以它不出现在后端的运行时配置里。
# 留空时保持 Caddyfile.prod 中 email 指令注释状态,否则 Caddy 会启动失败
JANUS_ACME_EMAIL=

