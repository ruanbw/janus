# CLOAK 后端环境变量(示例)。开发默认值即括号内值,可直接省略。
# 平台域名(开发用 RFC 保留测试域)
CLOAK_PLATFORM_DOMAIN=cloak.test
# 本服务器公网 IP:DNS 激活校验比对地址;开发环境 hosts 指向 127.0.0.1
CLOAK_SERVER_PUBLIC_IP=127.0.0.1
# HTTP 监听地址
CLOAK_ADDR=:8080
# Postgres 连接串
CLOAK_DATABASE_URL=postgres://cloak:cloak@localhost:5432/cloak?sslmode=disable
# 超管邮箱(环境变量指定,首次启动初始化;留空则无超管)
CLOAK_SUPERADMIN_EMAIL=
# 会话 cookie Secure 标记:开发(http)false,生产必须 true
CLOAK_COOKIE_SECURE=false
# 会话有效期(rememberMe=true/省略 30 天;false 24 小时)
CLOAK_SESSION_TTL=720h
CLOAK_SESSION_TTL_SHORT=24h
# 邮箱验证 / 密码重置 token 有效期
CLOAK_VERIFY_TOKEN_TTL=24h
CLOAK_RESET_TOKEN_TTL=1h
# DNS 校验重试间隔与最长重试时长(超时置 failed)
CLOAK_DNS_RETRY_INTERVAL=5m
CLOAK_DNS_MAX_AGE=72h
# 访问记录保留时长与清理间隔
CLOAK_VISIT_RETENTION=2160h
CLOAK_VISIT_CLEANUP_INTERVAL=24h
# SQL 迁移文件目录(容器内 /app/migrations)
CLOAK_MIGRATIONS_DIR=migrations
