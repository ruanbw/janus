# 生产构建:前后端分离(ADR-0006),产物由独立 nginx 镜像托管,经 Caddy 与后端同源,使用相对路径
VITE_API_PREFIX=/api
# 平台域名:仅用于注册页的默认域名提示(<前缀>.<平台域名>)。
# 这里写的是仓库默认值(开发用 RFC 保留测试域);自托管部署由构建参数覆盖:
# docker-compose.prod.yml 会把 .env 的 JANUS_PLATFORM_DOMAIN 传成
# --build-arg VITE_PLATFORM_DOMAIN,docker/Dockerfile 再写成 .env.production.local 参与构建。
VITE_PLATFORM_DOMAIN=janus.test
