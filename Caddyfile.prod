# CLOAK 生产 Caddy 配置:on-demand TLS + Let's Encrypt(ADR-0002、spec 决策 #8、ADR-0004、ADR-0006)
# ⚠️ Caddy 站点地址不支持环境变量占位符:把下面的 example.com 全部替换为你的平台域名
#    (与 .env 的 CLOAK_PLATFORM_DOMAIN 保持一致),再挂载到 Caddy 容器。
# 开发版见 Caddyfile(本地 CA)。
#
# 前后端分离(ADR-0006):Caddy 只做 TLS + 按路径分流,自身不托管任何文件。
#   /api、/internal、/healthz → backend(Go 后端)
#   其余                    → web(nginx 静态服务,只含前端构建产物)
{
	# ACME 账户邮箱(Let's Encrypt 到期提醒;可选)。
	# 注意:CLOAK_ACME_EMAIL 为空时,email 指令会让 Caddy 启动失败
	# ("expanding email address ... is empty")。因此默认注释掉:
	# 需要到期提醒时,取消注释下行并确保 .env 已设置 CLOAK_ACME_EMAIL。
	# email {env.ACME_EMAIL}

	# on-demand TLS:收到陌生域名的首个 TLS 握手时询问授权端点
	on_demand_tls {
		ask http://backend:8080/internal/caddy/authorize
	}
}

# 反代到后端时覆盖 X-Forwarded-For 为真实客户端 IP。
# Caddy 2 默认是**追加**到客户端自带值之后,不覆盖;后端取最右一段,
# 两侧约定必须同时成立,否则客户端可自带 XFF 伪造来源 IP(绕过限流/污染统计)。
(backend_proxy) {
	reverse_proxy backend:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

# 后台域名分流规则在两个站点间复用(app 后台域名与裸平台域名行为一致)
# 注意:这里**不**代理 /internal/*。授权端点只接受来自本网络的直连,
# 经反代后 RemoteAddr 是 Caddy 容器地址、内网判定恒真,公网可达就等于
# 任意访客可枚举哪些租户域名处于 active。on_demand_tls 的 ask 由 Caddy
# 进程直连 backend:8080,不经站点路由,删掉不影响签发。
(console) {
	handle /api/* {
		import backend_proxy
	}
	handle /healthz {
		import backend_proxy
	}
	handle {
		reverse_proxy web:80
	}
}

# 裸平台域名:承载后台(授权端点对裸平台域名始终放行)
example.com {
	tls {
		on_demand
	}
	import console
}

# 后台专用域名 app.<平台域名>
app.example.com {
	tls {
		on_demand
	}
	import console
}

# 全部租户子域(泛域名匹配;依赖 DNS 上 *.<平台域名> → 本服务器):
# 短链跳转与落地页是后端业务逻辑,整站反代到 Go 后端
*.example.com {
	tls {
		on_demand
	}
	# 同 console:授权端点不暴露给公网(整站反代会让它从任意租户子域可达)
	handle /internal/* {
		respond 404
	}
	handle {
		import backend_proxy
	}
}
