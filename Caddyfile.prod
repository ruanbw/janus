# Janus 生产 Caddy 配置:on-demand TLS + Let's Encrypt(ADR-0002、spec 决策 #8、ADR-0004、ADR-0006)
# ⚠️ Caddy 站点地址不支持环境变量占位符:把下面的 example.com 全部替换为你的平台域名
#    (与 .env 的 JANUS_PLATFORM_DOMAIN 保持一致),再挂载到 Caddy 容器。
# 开发版见 Caddyfile(本地 CA)。
#
# 本文件是默认模式:每个租户默认域名 <slug>.<平台域名> 各自 on-demand 签一张证书(ADR-0004),
# 受 Let's Encrypt 每周配额约束。租户规模大或担心注册 spam 耗尽配额时,改用
# Caddyfile.prod.wildcard(一张 *.<平台域名> 泛域名证书,DNS-01)并设置
# JANUS_WILDCARD_TLS=true,见 docs/deploy.md「泛域名证书模式」。
#
# 前后端分离(ADR-0006):Caddy 只做 TLS + 按路径分流,自身不托管任何文件。
#   /api、/internal、/healthz → backend(Go 后端)
#   其余                    → web(nginx 静态服务,只含前端构建产物)
{
	# ACME 账户邮箱(Let's Encrypt 到期提醒;可选)。
	# 注意:JANUS_ACME_EMAIL 为空时,email 指令会让 Caddy 启动失败
	# ("expanding email address ... is empty")。因此默认注释掉:
	# 需要到期提醒时,取消注释下行并确保 .env 已设置 JANUS_ACME_EMAIL。
	# email {env.ACME_EMAIL}

	# on-demand TLS:收到陌生域名的首个 TLS 握手时询问授权端点
	on_demand_tls {
		# 共享密钥随每次询问一起送,由环境变量注入(不写死在文件里):
		#   {$CADDY_ASK_TOKEN} 由 Caddyfile 适配器在 adapt 时展开成字面值,
		#   所以 CADDY_ASK_TOKEN 必须是 caddy 容器环境里的变量
		#   (docker-compose.prod.yml 的 caddy 服务需要转发它,见 docs/deploy.md)。
		# 后端做常量时间比对,缺失/错误一律拒绝(fail-closed)。
		# 没有它,授权端点只剩"对端是内网"这一层判断 —— 运维给 backend 加了
		# ports: 映射、或前面再套一层反代(来源是内网 IP)时判定恒真,
		# 一个无认证 GET 就公网可调:能枚举哪些租户域名处于 active,并引导
		# Caddy 为它们签发证书。
		#
		# 为什么走查询参数而不是请求头:Caddy 2.11 的 Caddyfile 不支持给 ask 请求
		# 加自定义头(ask <url> { header ... } 报 unrecognized parameter '{')。
		# 后端同时接受 X-Janus-Caddy-Token 头,Caddy 支持时可直接切换过去。
		ask http://backend:8080/internal/caddy/authorize?token={$CADDY_ASK_TOKEN}
	}
}

# 反代到后端时覆盖 X-Forwarded-For 为真实客户端 IP。
# Caddy 2 默认是**追加**到客户端自带值之后,不覆盖;后端取最右一段,
# 两侧约定必须同时成立,否则客户端可自带 XFF 伪造来源 IP(绕过限流/污染统计)。
(backend_proxy) {
	reverse_proxy backend:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

# 后台域名分流规则在两个站点间复用(app 后台域名与裸平台域名行为一致)
# 注意:这里**不**代理 /internal/*。授权端点只接受来自本网络的直连,
# 经反代后 RemoteAddr 是 Caddy 容器地址、内网判定恒真,公网可达就等于
# 任意访客可枚举哪些租户域名处于 active。on_demand_tls 的 ask 由 Caddy
# 进程直连 backend:8080,不经站点路由,删掉不影响签发。
(console) {
	handle /api/* {
		import backend_proxy
	}
	handle /healthz {
		import backend_proxy
	}
	handle {
		reverse_proxy web:80
	}
}

# 裸平台域名:承载后台(授权端点对裸平台域名始终放行)
example.com {
	tls {
		on_demand
	}
	import console
}

# 后台专用域名 app.<平台域名>
app.example.com {
	tls {
		on_demand
	}
	import console
}

# 全部租户子域(泛域名匹配;依赖 DNS 上 *.<平台域名> → 本服务器):
# 短链跳转与落地页是后端业务逻辑,整站反代到 Go 后端
# 注意:这里的 on_demand 意味着每个租户子域一张证书(会消耗 Let's Encrypt 配额);
# 泛域名证书方案见 Caddyfile.prod.wildcard。
*.example.com {
	tls {
		on_demand
	}
	# 同 console:授权端点不暴露给公网(整站反代会让它从任意租户子域可达)
	handle /internal/* {
		respond 404
	}
	handle {
		import backend_proxy
	}
}

# ---------- catch-all:租户自有域名 ----------
#
# 为什么必须存在:上面的站点块只匹配 example.com / app.example.com / *.example.com,
# 而授权端点放行的是**任意** active 自有域名(含 short.customer.com 这类与平台
# 完全无关的域名)。on_demand_tls.ask 只回答"该不该签",不回答"有没有路由" ——
# 没有匹配的站点块时 Caddy 根本不服务那个主机名。于是 README 与部署文档承诺的
# "自有域名 → 激活 → 自动签发证书 → 短链跳转"在生产实际不可用。
#
# 写法要点:
#   - 地址写 `:443`:不带 host 限制的站点块才覆盖所有未匹配的主机名;
#   - tls { on_demand }:这一块自己也要声明,否则没有 TLS automation policy;
#   - /internal/* 一律 404:整站反代会让授权端点从任意租户域名可达。
:443 {
	tls {
		on_demand
	}
	handle /internal/* {
		respond 404
	}
	handle {
		import backend_proxy
	}
}
