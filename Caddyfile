# Janus Caddy 配置:on-demand TLS + 本地 CA(开发) / Let's Encrypt(生产)
# 授权端点询问 Go 后端:放行 active 租户域名,拒绝未授权域名(ADR-0002、spec 决策 #8)。
# 平台默认域名按子域逐个签发(ADR-0004)。
# 开发环境:Go 后端在宿主机终端启动(JANUS_ADDR=:8080),Caddy 经 host.docker.internal 反代;
# 生产环境改为 Let's Encrypt:删除 local_certs,并在各站点 tls 指令去掉 internal,后端在 compose 网络内(backend:8080)。
# 注意:Caddy 2.11+ 全局选项名为 on_demand_tls(旧版为 on_demand),子选项仅 ask/permission;
# 签发频率限流由 ask 端点(授权端点)与应用侧控制。
#
# 前后端分离(ADR-0006),与生产同构:
#   /api、/internal、/healthz → Go 后端(:8080)
#   其余                    → Vite dev server(:5173),改前端即时热更新,无需任何打包
{
	# 本地 CA:开发环境证书签发器(spike 01 验证 tls internal + on_demand 组合);
	# 生产改为 Let's Encrypt:删除 local_certs,并在各站点 tls 指令去掉 internal。
	local_certs

	on_demand_tls {
		# 共享密钥:与后端 JANUS_CADDY_ASK_TOKEN 同一个值(环境变量注入)。
		# Caddy 2.11 的 Caddyfile 不能给 ask 请求加自定义头,只能用查询参数;
		# 后端同时接受 X-Janus-Caddy-Token 头。
		ask http://host.docker.internal:8080/internal/caddy/authorize?token={$CADDY_ASK_TOKEN}
	}
}

# 反代到后端时覆盖 X-Forwarded-For 为真实客户端 IP(Caddy 2 默认追加而非覆盖;
# 后端取最右一段,两侧约定必须同时成立,否则访客可自带 XFF 伪造来源 IP)。
(backend_proxy) {
	reverse_proxy host.docker.internal:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

# 后台域名分流规则(app 后台域名与裸平台域名行为一致)
# 不代理 /internal/*:授权端点只接受本网络直连,经反代后内网判定恒真
(console) {
	handle /api/* {
		import backend_proxy
	}
	handle /healthz {
		import backend_proxy
	}
	handle {
		# Vite dev server:Caddy 默认透传原始 Host 头,配合 vite.config.ts 的
		# server.allowedHosts 放行;WebSocket(HMR)由 reverse_proxy 自动upgrade。
		reverse_proxy host.docker.internal:5173
	}
}

# 裸平台域名:承载后台
#
# 为什么控制台域名也必须写 on_demand(与 Caddyfile.prod 的 example.com /
# app.example.com 保持一致):本文件里有 *.janus.test 泛域名站点,Caddy 的
# TLS.Manage() 会把被通配符覆盖的 janus.test / app.janus.test 从"启动期统一
# 签发"名单里剔除;而这两块若不声明 on_demand,握手时策略又不是按需签发,又没有
# 预签好的证书可用,结果是 TLS alert internal error —— Caddy 默认日志级别下
# 连一行错误都不打,只有 debug 才见 "no certificate available for 'app.janus.test'"。
# 授权端点对裸平台域名与 app 子域始终放行(见 internal/httpapi/internal.go),
# 因此这里的 ask 只是走一遍放行逻辑。
janus.test {
	tls internal {
		on_demand
	}
	import console
}

# 后台专用域名 app.<平台域名>
app.janus.test {
	tls internal {
		on_demand
	}
	import console
}

# 全部租户子域(泛域名匹配):短链跳转与落地页是后端业务逻辑,整站反代
*.janus.test {
	tls internal {
		on_demand
	}
	handle /internal/* {
		respond 404
	}
	handle {
		import backend_proxy
	}
}

# ---------- catch-all:租户自有域名 ----------
#
# 上面的站点块只匹配 janus.test / app.janus.test / *.janus.test,而授权端点放行的是
# **任意** active 自有域名。on_demand_tls.ask 只回答"该不该签",不回答"有没有路由" ——
# 没有匹配的站点块时 Caddy 根本不服务那个主机名,于是"自有域名 → 自动签证书 →
# 短链跳转"这条链路就不成立。:443(不带 host 限制)才是覆盖所有未匹配主机名的写法。
:443 {
	tls internal {
		on_demand
	}
	handle /internal/* {
		respond 404
	}
	handle {
		import backend_proxy
	}
}
